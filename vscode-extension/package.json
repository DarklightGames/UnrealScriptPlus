{
  "name": "unrealscript",
  "displayName": "UnrealScript",
  "description": "UnrealScript language support with LSP",
  "version": "0.1.0",
  "publisher": "unrealscript",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmbasnett/UnrealScriptPlus.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:unrealscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "unrealscript",
        "aliases": [
          "UnrealScript",
          "unrealscript"
        ],
        "extensions": [
          ".uc",
          ".uci"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "unrealscript",
        "scopeName": "source.unrealscript",
        "path": "./syntaxes/unrealscript.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "boolean",
        "superType": "keyword",
        "description": "A boolean literal"
      },
      {
        "id": "vector",
        "superType": "type",
        "description": "A vector literal"
      },
      {
        "id": "rotator",
        "superType": "type",
        "description": "A rotator literal"
      },
      {
        "id": "objectLiteral",
        "superType": "string",
        "description": "An object literal reference"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "unrealscript",
        "scopes": {
          "boolean": ["constant.language.boolean.unrealscript"],
          "vector": ["support.type.vector.unrealscript"],
          "rotator": ["support.type.rotator.unrealscript"],
          "objectLiteral": ["string.quoted.other.unrealscript"]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
